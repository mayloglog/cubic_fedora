    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/cubic-fedora/commands/current-directory</annotate>
  </action>
  <action id="cubic-fedora.delete">
    <description>Delete a file or directory for Cubic Fedora.</description>
    <message>Enter the administrator password to delete a file or directory for Cubic Fedora.</message>
    <icon_name>cubic-fedora</icon_name>
    <defaults>
