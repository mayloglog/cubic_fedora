    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/cubic-fedora/commands/delete-path</annotate>
  </action>
  <action id="cubic-fedora.directory-usage">
    <description>Get directory usage (used, available, and used %) in bytes for Cubic Fedora.</description>
    <message>Enter the administrator password to get directory usage (used, available, and used %) in bytes for Cubic Fedora.</message>
    <icon_name>cubic-fedora</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
