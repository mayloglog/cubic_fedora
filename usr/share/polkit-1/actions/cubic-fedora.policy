    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/cubic-fedora/commands/directory-usage</annotate>
  </action>
  <action id="cubic-fedora.extract-root">
    <description>Extract the root file system for Cubic Fedora.</description>
    <message>Enter the administrator password to extract the root file system for Cubic Fedora.</message>
    <icon_name>cubic-fedora</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
