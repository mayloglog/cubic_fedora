<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="cubic-fedora.compress-root">
    <description>Compress the root file system for Cubic Fedora.</description>
    <message>Enter the administrator password to compress the root file system for Cubic Fedora.</message>
    <icon_name>cubic-fedora</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/cubic-fedora/commands/compress-root</annotate>
  </action>
  <action id="cubic-fedora.copy-path">
    <description>Copy a file or directory for Cubic Fedora.</description>
    <message>Enter the administrator password to copy a file or directory for Cubic Fedora.</message>
    <icon_name>cubic-fedora</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/cubic-fedora/commands/copy-path</annotate>
  </action>
  <action id="cubic-fedora.current-directory">
    <description>Get the virtual environment current directory for Cubic Fedora.</description>
    <message>Enter the administrator password to get the virtual environment current directory for Cubic Fedora.</message>
    <icon_name>cubic-fedora</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
